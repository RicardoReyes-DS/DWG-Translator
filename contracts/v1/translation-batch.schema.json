{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dwgtranslator.internal/contracts/v1/translation-batch.schema.json",
  "title": "Translation batch v1",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "request": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/requestEnvelope" },
        {
          "properties": {
            "messageType": { "const": "translation.batch.request" },
            "payload": {
              "type": "object",
              "required": ["sourceLanguage", "targetLanguage", "promptTemplateVersion", "glossary", "segments"],
              "properties": {
                "sourceLanguage": { "oneOf": [{ "$ref": "common.schema.json#/$defs/languageTag" }, { "type": "null" }] },
                "targetLanguage": { "$ref": "common.schema.json#/$defs/languageTag" },
                "promptTemplateVersion": { "type": "string", "minLength": 1, "maxLength": 120 },
                "glossary": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/glossaryEntry" } },
                "segments": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/segment" } }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "response": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/successResponseEnvelope" },
        {
          "properties": {
            "messageType": { "const": "translation.batch.response" },
            "status": { "const": "Succeeded" },
            "payload": {
              "type": "object",
              "required": ["model", "promptTemplateVersion", "proposals", "usage"],
              "properties": {
                "model": { "type": "string", "minLength": 1, "maxLength": 120 },
                "promptTemplateVersion": { "type": "string", "minLength": 1, "maxLength": 120 },
                "proposals": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/proposal" } },
                "usage": {
                  "type": "object",
                  "required": ["inputTokens", "outputTokens"],
                  "properties": {
                    "inputTokens": { "type": "integer", "minimum": 0 },
                    "outputTokens": { "type": "integer", "minimum": 0 }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "failure": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/failureResponseEnvelope" },
        { "properties": { "messageType": { "const": "translation.batch.response" } } }
      ]
    },
    "glossaryEntry": {
      "type": "object",
      "required": ["source", "target"],
      "properties": {
        "source": { "type": "string", "minLength": 1, "maxLength": 500 },
        "target": { "type": "string", "minLength": 1, "maxLength": 500 },
        "caseSensitive": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "required": ["segmentId", "textWithTokenAliases", "protectedTokenAliases", "context"],
      "properties": {
        "segmentId": { "$ref": "common.schema.json#/$defs/segmentId" },
        "textWithTokenAliases": { "type": "string", "maxLength": 65535 },
        "protectedTokenAliases": { "type": "object", "maxProperties": 1000, "propertyNames": { "pattern": "^T[0-9]+$" }, "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 1000 } },
        "context": {
          "type": "object",
          "required": ["entityType", "space", "layout", "layer", "blockPath"],
          "properties": {
            "entityType": { "enum": ["TEXT", "MTEXT"] },
            "space": { "enum": ["ModelSpace", "PaperSpace"] },
            "layout": { "type": ["string", "null"], "maxLength": 255 },
            "layer": { "type": "string", "minLength": 1, "maxLength": 255 },
            "blockPath": { "type": "array", "maxItems": 0 },
            "contextVersion": { "enum": ["cad-semantic-context/1.0", "cad-semantic-context/1.1", "cad-semantic-context/1.2", "cad-semantic-context/1.3"] },
            "contextHash": { "$ref": "common.schema.json#/$defs/sha256" },
            "semanticKey": { "$ref": "common.schema.json#/$defs/sha256" },
            "sheetRole": { "enum": ["Model", "Sheet"] },
            "discipline": { "enum": ["Unknown", "Architectural", "Structural", "Mechanical", "Electrical", "Plumbing", "Fire", "Controls"] },
            "disciplineConflict": { "type": "boolean" },
            "disciplineResolution": { "enum": ["LOCAL_EVIDENCE_OVERRIDES_DRAWING_HINT", "DRAWING_NAME_ARCHITECTURAL_FALLBACK", "DRAWING_NAME_ELECTRICAL_FALLBACK", "DRAWING_NAME_STRUCTURAL_FALLBACK"] },
            "xBand": { "type": "integer", "minimum": 0, "maximum": 15 },
            "yBand": { "type": "integer", "minimum": 0, "maximum": 15 },
            "signals": {
              "type": "array",
              "maxItems": 8,
              "uniqueItems": true,
              "items": { "enum": ["CEILING_CONTEXT", "RAISED_FLOOR_CONTEXT", "ROOF_CONTEXT", "VERTICAL_LEVEL_CONTEXT_CONFLICT"] }
            },
            "neighborExcerpts": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/neighborExcerpt" } }
          },
          "allOf": [
            {
              "if": { "properties": { "space": { "const": "ModelSpace" } }, "required": ["space"] },
              "then": { "properties": { "layout": { "type": ["null"] } } },
              "else": { "properties": { "layout": { "type": "string", "minLength": 1 } } }
            },
            {
              "if": {
                "anyOf": [
                  { "required": ["contextVersion"] }, { "required": ["contextHash"] }, { "required": ["semanticKey"] },
                  { "required": ["sheetRole"] }, { "required": ["discipline"] }, { "required": ["disciplineConflict"] },
                  { "required": ["disciplineResolution"] },
                  { "required": ["xBand"] }, { "required": ["yBand"] }, { "required": ["signals"] }, { "required": ["neighborExcerpts"] }
                ]
              },
              "then": {
                "required": ["contextVersion", "contextHash", "semanticKey", "sheetRole", "discipline", "disciplineConflict", "xBand", "yBand", "signals", "neighborExcerpts"]
              }
            },
            {
              "if": { "properties": { "contextVersion": { "const": "cad-semantic-context/1.0" } }, "required": ["contextVersion"] },
              "then": { "not": { "required": ["disciplineResolution"] } }
            },
            {
              "if": { "properties": { "discipline": { "const": "Structural" } }, "required": ["discipline"] },
              "then": { "properties": { "contextVersion": { "const": "cad-semantic-context/1.3" } } }
            },
            {
              "if": {
                "properties": { "disciplineResolution": { "const": "LOCAL_EVIDENCE_OVERRIDES_DRAWING_HINT" } },
                "required": ["disciplineResolution"]
              },
              "then": {
                "properties": {
                  "contextVersion": { "enum": ["cad-semantic-context/1.1", "cad-semantic-context/1.2", "cad-semantic-context/1.3"] },
                  "discipline": { "enum": ["Architectural", "Structural", "Mechanical", "Electrical", "Plumbing", "Fire"] },
                  "disciplineConflict": { "const": false }
                }
              }
            },
            {
              "if": {
                "properties": { "disciplineResolution": { "const": "DRAWING_NAME_ARCHITECTURAL_FALLBACK" } },
                "required": ["disciplineResolution"]
              },
              "then": {
                "properties": {
                  "contextVersion": { "enum": ["cad-semantic-context/1.2", "cad-semantic-context/1.3"] },
                  "discipline": { "const": "Architectural" },
                  "disciplineConflict": { "const": false }
                }
              }
            },
            {
              "if": {
                "properties": { "disciplineResolution": { "const": "DRAWING_NAME_ELECTRICAL_FALLBACK" } },
                "required": ["disciplineResolution"]
              },
              "then": {
                "properties": {
                  "contextVersion": { "const": "cad-semantic-context/1.3" },
                  "discipline": { "const": "Electrical" },
                  "disciplineConflict": { "const": false }
                }
              }
            },
            {
              "if": {
                "properties": { "disciplineResolution": { "const": "DRAWING_NAME_STRUCTURAL_FALLBACK" } },
                "required": ["disciplineResolution"]
              },
              "then": {
                "properties": {
                  "contextVersion": { "const": "cad-semantic-context/1.3" },
                  "discipline": { "const": "Structural" },
                  "disciplineConflict": { "const": false }
                }
              }
            }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "neighborExcerpt": {
      "type": "object",
      "required": ["segmentId", "sourceTextHash", "entityType", "relation", "distanceBand", "sameLayer", "text"],
      "properties": {
        "segmentId": { "$ref": "common.schema.json#/$defs/segmentId" },
        "sourceTextHash": { "$ref": "common.schema.json#/$defs/sha256" },
        "entityType": { "enum": ["TEXT", "MTEXT"] },
        "relation": { "enum": ["SamePosition", "Above", "Below", "Left", "Right"] },
        "distanceBand": { "type": "integer", "minimum": 0, "maximum": 3 },
        "sameLayer": { "type": "boolean" },
        "text": { "type": "string", "maxLength": 160 }
      },
      "additionalProperties": false
    },
    "proposal": {
      "type": "object",
      "required": ["segmentId", "translatedTextWithTokenAliases", "tokenIntegrity"],
      "properties": {
        "segmentId": { "$ref": "common.schema.json#/$defs/segmentId" },
        "translatedTextWithTokenAliases": { "type": "string", "maxLength": 65535 },
        "tokenIntegrity": { "enum": ["Valid", "Invalid"] }
      },
      "additionalProperties": false
    }
  }
}
