{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dwgtranslator.internal/contracts/v1/signature-policy.schema.json",
  "type": "object",
  "required": ["schemaVersion", "product", "allowedSignToolSha256", "allowedSignToolSignerThumbprints", "allowedPublisherThumbprints", "expectedProductVersion"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "product": { "const": "DWG Translator" },
    "allowedSignToolSha256": { "$ref": "#/$defs/shaSet" },
    "allowedSignToolSignerThumbprints": { "$ref": "#/$defs/thumbprintSet" },
    "allowedPublisherThumbprints": { "$ref": "#/$defs/thumbprintSet" },
    "expectedProductVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))?$" }
  },
  "$defs": {
    "shaSet": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "thumbprintSet": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9a-f]{40}$" } }
  },
  "additionalProperties": false
}
